# Copy to .env on the relay host. Non-secret settings only (except the frps
# admin password, which frp can only read from its config/env).

TUNNELHUB_VERSION=dev

# Public hostname of the dashboard/API (needs a DNS A record -> relay IP).
TH_DOMAIN=tunnels.example.com

# Address agents connect to for tunnels (hostname or IP). Must match a SAN in
# the relay certificate made by scripts/gen-certs.sh.
RELAY_ADDR=relay.example.com

# Public tunnel port pool (TCP and UDP). Keep below 32768 (kernel ephemeral range).
TUNNEL_PORT_START=20000
TUNNEL_PORT_END=29999
MAX_PORTS_PER_DEVICE=20
MAX_DEVICES_PER_USER=10

# Ports outside the pool that the relay also allows (comma-separated). Only
# admins and reservations can use them. Add the same to frps allowPorts.
EXTRA_PORTS=

# How long a released port is kept from other users (e.g. 24h, 0 = off).
PORT_COOLDOWN=24h

# Anyone may sign up when true; otherwise create users with
#   docker compose run --rm -T control create-user -email you@example.com -admin
OPEN_REGISTRATION=false

# frps admin/stats API on 127.0.0.1:7500. Generate with: openssl rand -hex 24
FRPS_ADMIN_PASSWORD=change-me
