# TEMPLATE ONLY — not applied anywhere. Review, adapt the interface name and
# the admin source address, then load with:  sudo nft -c -f FILE  (check)
#                                            sudo nft -f FILE     (apply)
# Assumes the default policy is "drop" for input and that Docker's own rules
# live in its own chains (Docker adds its nat/filter chains; this file only
# owns table inet tunnelhub).
#
# Public surface of the relay:
#   80/tcp, 443/tcp+udp        HTTPS API + dashboard (Caddy)
#   7000/tcp+udp               agent <-> relay (frps)
#   20000-29999/tcp+udp        public tunnel ports (plus any TH_EXTRA_PORTS)
#   22/tcp                     SSH, only from the admin address
# Not opened: 7500 (frps dashboard, bound to the Docker bridge), 8081 (plugin,
# loopback), 5432 (PostgreSQL, internal network only).

table inet tunnelhub {
	set admin_ssh {
		type ipv4_addr
		elements = { 198.51.100.7 }   # replace with your admin address
	}

	chain input {
		type filter hook input priority 0; policy drop;

		ct state invalid drop
		ct state established,related accept
		iifname "lo" accept

		# ICMP for path MTU discovery; keep echo rate-limited.
		ip protocol icmp icmp type echo-request limit rate 5/second accept
		ip6 nexthdr icmpv6 accept

		ip saddr @admin_ssh tcp dport 22 ct state new accept

		tcp dport { 80, 443, 7000 } ct state new accept
		udp dport { 443, 7000 } accept

		# Public tunnels: new flows per source limited; 40/s per source is far
		# above normal play and well below a flood. Tune for your uplink.
		tcp dport 20000-29999 ct state new \
			meter tunnel_new_v4 { ip saddr limit rate over 40/second } drop
		tcp dport 20000-29999 accept
		udp dport 20000-29999 accept

		# Reserved ports used by TH_EXTRA_PORTS (edit to match).
		# tcp dport 25565 accept
	}

	chain forward {
		type filter hook forward priority 0; policy drop;
		# Docker manages forwarding for its own networks; nothing added here.
	}
}
